# ==============================================================================
# Git Ignore - Exocortex & Télémétrie Cognitive
# Règle d'or : Conservation du scaffold / arborescence via .gitkeep,
# exclusion stricte du contenu utilisateur, modèles lourds et buffers.
# ==============================================================================

# --- Modèles de Poids d'Inférence (GGUF, SafeTensors, Bin) ---
models/*
!models/.gitkeep
*.gguf
*.bin
*.safetensors
*.pt
*.onnx

# --- Données Brutes Takeout ---
takeout_raw/*
!takeout_raw/.gitkeep
takeoutraw/*
!takeoutraw/.gitkeep

# --- Coffre Utilisateur (Arborescence préservée, contenu exclu) ---
Vault_Data/00_Meta/*
!Vault_Data/00_Meta/.gitkeep

Vault_Data/01_Episodique/*
!Vault_Data/01_Episodique/.gitkeep

Vault_Data/02_Concepts/*
!Vault_Data/02_Concepts/.gitkeep

Vault_Data/Google_Drive_Sync/*
!Vault_Data/Google_Drive_Sync/.gitkeep

# --- Tampons Système, Télémétrie & Bases de Données Locales ---
Vault_Data/.obsidian/*
Vault_Data/_System_Buffer/*
!Vault_Data/_System_Buffer/.gitkeep
Vault_Data/_System_Buffer/screen_staging/*
!Vault_Data/_System_Buffer/screen_staging/.gitkeep
Vault_Data/_System_Buffer/takeout_staging/*
!Vault_Data/_System_Buffer/takeout_staging/.gitkeep
Vault_Data/_System_Buffer/lancedb_store/*
!Vault_Data/_System_Buffer/lancedb_store/.gitkeep
takeout_staging/*
!takeout_staging/.gitkeep

*.db
*.db-wal
*.db-shm
*.webp

# --- Fichiers d'Environnement & Clés Secrètes ---
.env
.env.local
.env.*.local
*.key
credentials.json

# --- Exports & Dumps Temporaires ---
repomix-output.xml
repomix-output.txt
*.log

# --- Fichiers Python & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Environnements Virtuels ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Caches Outils & Tests ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDEs & Éditeurs ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.cursor/

# --- Fichiers Système d'Exploitation ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# ==============================================================================
# EXOCORTEX & TÉLÉMÉTRIE COGNITIVE - VARIABLES D'ENVIRONNEMENT
# Copier ce fichier sous le nom .env et renseigner les valeurs souhaitées.
# Toutes les variables lues par src/config.py sont listées ici, avec leur valeur par défaut
# (v0.5.7, audit G5). Une variable déjà définie dans l'environnement prime sur le .env.
# ==============================================================================

# --- Chemins du Système & Coffre de Données ---
VAULT_ROOT=./Vault_Data
TAKEOUT_DIR=./takeout_raw
# Fuseau des horodatages stockés en base (les exports Takeout JSON en UTC sont convertis)
LOCAL_TIMEZONE=Europe/Paris

# --- Inférence Locale (Ollama / Llama-server) ---
MODELS_DIR=./models
LLM_BACKEND=ollama
GGUF_FAST_FILENAME=gemma-4-12b-it-Q4_K_M.gguf
GGUF_HEAVY_FILENAME=gemma-4-26B-A4B-it-UD-IQ4_NL.gguf
OLLAMA_BASE_URL=http://localhost:11434
LLAMA_SERVER_BASE_URL=http://localhost:8080/v1
MODEL_FAST_VISION=gemma4:12b
MODEL_HEAVY_SYNTHESIS=gemma4:26b-a4b
MODEL_EMBEDDING=bge-m3
# Fenêtre de contexte envoyée à CHAQUE requête (une valeur variable force un rechargement du modèle)
OLLAMA_NUM_CTX=16384

# --- Budget Matériel VRAM (RTX 4070 Ti Super - 16 Go VRAM) ---
# Seuil minimal en dessous duquel aucun LLM ne tourne (mode Jeu/3D actif). Ancien nom : MIN_FREE_VRAM_GB
VRAM_STRICT_ABORT_FREE_GB=8.0
# Seuil autorisant le modèle 26B lourd (~14.2 Go) sous Windows 11. Ancien nom : FULL_DUAL_MODEL_VRAM_GB
VRAM_REASONING_MIN_FREE_GB=12.8
# VRAM supposée libre si aucune sonde GPU (pynvml, nvidia-smi) ne répond : 0 = abstention prudente
VRAM_ASSUME_FREE_GB=0
# Attente maximale du GPU détenu par un autre processus Exocortex avant report (secondes)
VRAM_LOCK_TIMEOUT_SEC=900

# --- Optimisations du SERVEUR Ollama ---
# À définir au niveau UTILISATEUR Windows puis redémarrer Ollama (un .bat ou ce .env n'ont aucun
# effet sur un serveur lancé séparément). `python run_exocortex.py --init-models` vérifie la
# configuration réelle du processus serveur et prévient si elle manque.
#   setx OLLAMA_FLASH_ATTENTION 1     # FlashAttention : divise la bande passante mémoire
#   setx OLLAMA_KV_CACHE_TYPE q8_0    # Cache KV 8 bits : borne la consommation VRAM du 26B
#   setx OLLAMA_MAX_LOADED_MODELS 1   # Un seul modèle résident
#   setx OLLAMA_NUM_PARALLEL 1        # Pas de slots mémoire concurrents

# --- Inférence Cloud SOTA (Optionnelle) ---
# Options : "web_manual" (0 € via copier/coller dans Gemini Pro Web) ou "cloud_api" (SDK google-genai)
TAKEOUT_MODE=web_manual
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Limite de sessions qualifiées à distiller lors du Takeout (0 = toutes les sessions qualifiées)
TAKEOUT_MAX_DISTILL_SESSIONS=0

# --- Sessionisation & Filtrage Bruit Google Takeout (Module 1) ---
INACTIVITY_SESSION_THRESHOLD_MIN=45
MIN_TURNS_THRESHOLD=3
MIN_USER_CHARS_THRESHOLD=250

# --- Corrélation Multi-Takeout (Google Search & YouTube) ---
SEARCH_BURST_WINDOW_MIN=45
SEARCH_BURST_MIN_EVENTS=5
TEMPORAL_JOIN_BEFORE_MIN=60
TEMPORAL_JOIN_AFTER_MIN=30

# --- Démon Temps Réel OS Win32 (Module 2) ---
POLLING_INTERVAL_SEC=2
DWELL_TIME_THRESHOLD_SEC=20
PROLONGED_SESSION_THRESHOLD_SEC=180
DHASH_MAX_HAMMING_DISTANCE=5
# Fenêtre close après N secondes sans saisie (temps d'inactivité non compté) ; seuil plus long en lecture média
IDLE_SPLIT_THRESHOLD_SEC=300
IDLE_SPLIT_MEDIA_THRESHOLD_SEC=3600
# Captures du staging non référencées supprimées au-delà de cet âge (heures)
SCREEN_ORPHAN_MAX_AGE_HOURS=24

# --- Confidentialité (liste noire en mots entiers et par domaine) ---
# Termes et domaines ajoutés aux listes intégrées (séparés par des virgules)
TITLE_BLACKLIST_EXTRA=
SENSITIVE_DOMAINS_EXTRA=
# Catégories jamais exportées vers Google_Drive_Sync (séparées par des virgules)
DRIVE_EXCLUDED_TOPICS=Sante_et_Pharmacologie,Introspection_et_Neuroatypie,Admin_Finance_et_Droit

# --- DriftGuard (Module 8) ---
DRIFT_MAX_SWITCHES_30MIN=25
DRIFT_MAX_PASSIVE_MIN=90
# La dérive média n'est signalée qu'après un tunnel de production d'au moins N minutes
DRIFT_MIN_PRODUCTION_TUNNEL_MIN=30
DRIFT_PRODUCTION_LOOKBACK_MIN=60

# --- Injecteur Hippocampe (Module 5) : syntaxe pynput ---
HIPPOCAMPUS_HOTKEY=<ctrl>+<alt>+<space>

# --- Récepteur de l'extension navigateur (port 8502) ---
BROWSER_RECEIVER_HOST=127.0.0.1
BROWSER_RECEIVER_PORT=8502
BROWSER_RECEIVER_MAX_BODY_BYTES=524288

# --- Command Center Web (port 8500) ---
WEB_GUI_HOST=127.0.0.1
WEB_GUI_PORT=8500
# Origines autorisées en CORS (fronts de développement) et noms d'hôte acceptés (anti DNS rebinding)
WEB_GUI_CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:5173,http://127.0.0.1:5173
WEB_GUI_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Jetons locaux (optionnels) ---
# Par défaut générés dans Vault_Data/_System_Buffer/api_token et browser_receiver_token
# EXOCORTEX_API_TOKEN=
# EXOCORTEX_BROWSER_RECEIVER_TOKEN=

# --- Kanban ---
# Racines autorisées pour repo_path (séparées par ';'). Vide = tout dépôt Git local
KANBAN_ALLOWED_REPO_ROOTS=
